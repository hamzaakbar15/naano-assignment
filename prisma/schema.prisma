generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // bcrypt hash; Credentials-only auth, no OAuth path in scope
  name      String?
  role      Role
  createdAt DateTime @default(now())

  creatorProfile CreatorProfile?
  companyProfile CompanyProfile?
  messages       Message[]
}

enum Role {
  CREATOR
  COMPANY
}

model CreatorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedinUrl  String?
  country      String?
  industries   String[] // simple string array, max 3 enforced in UI
  pricePerPost Int // whole currency units (e.g. USD), not cents
  headline     String?

  collaborations Collaboration[]
  conversations  Conversation[]

  @@index([country])
}

model CompanyProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  website     String?

  collaborations Collaboration[]
  conversations  Conversation[]
}

model Collaboration {
  id        String         @id @default(cuid())
  companyId String
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status    CollabStatus   @default(PENDING)
  price     Int
  dueDate   DateTime?
  postUrl   String? // filled in when creator "delivers"
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([companyId])
  @@index([creatorId])
  @@index([status])
}

// One thread per company-creator pair, opened by their first booking; later
// bookings between the same pair continue in it. Each side keeps a last-read
// timestamp so unread counts are just "messages from the other side since".
model Conversation {
  id                String         @id @default(cuid())
  companyId         String
  company           CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creatorId         String
  creator           CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  lastMessageAt     DateTime?
  companyLastReadAt DateTime?
  creatorLastReadAt DateTime?
  createdAt         DateTime       @default(now())

  messages Message[]

  @@unique([companyId, creatorId])
  @@index([creatorId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

enum CollabStatus {
  PENDING // company booked, awaiting creator response
  DECLINED
  ACTIVE // creator accepted, post not yet delivered
  COMPLETED // post delivered
}
